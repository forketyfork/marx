#!/usr/bin/env bash
# Automatically load the Nix development environment
use flake

# Load any local environment variables if they exist
if [ -f .env ]; then
  dotenv .env
fi

# Load local overrides (1Password secrets, etc.) if they exist
if [ -f .envrc.local ]; then
  source .envrc.local
fi

# Load GitHub token if it exists in a secrets file
if [ -f .secrets ]; then
  dotenv .secrets
fi
